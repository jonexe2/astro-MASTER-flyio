# Copy to .env for local work. .env is git-ignored; this example file is committed
# and must contain placeholders only, never real values.
#
# Private settings live here (server-only), never in src/config/config.toml and
# never in variables starting with PUBLIC_ (those are sent to browsers).
# Production values are set as runtime secrets on the host (P8), not in a file.

# --- Used now (src/lib/server/settings.ts) ---
# "development" or "production". Required.
APP_ENV=development
# SQLite file. Development default is .data/dev.sqlite (git-ignored); inside the
# project only .data/ is allowed (never public/, dist/ or src/).
# Production must be an absolute path inside /data/ (planned Fly volume mount).
DATABASE_PATH=.data/dev.sqlite

# --- Reserved names for later phases (not read by any code yet) ---
# Owner login session signing secret (P4)
SESSION_SECRET=
# Resend email alerts (P6)
RESEND_API_KEY=
EMAIL_FROM=
LEAD_NOTIFY_TO=
# Google Sheets copy (P7)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
