---
import Base from "@/layouts/Base.astro";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils.ts";
import ServicesSingle from "@/components/ServicesSingle.astro";
import extractSlug from "@/lib/utils/extractSlug";
import config from ".astro/config.generated.json";
import PageHeader from "@/components/widgets/PageHeader.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import ServiceAreaSection from "@/components/sections/ServiceAreaSection.astro";
import WorkingProcessSection from "@/components/sections/WorkingProcessSection.astro";
import ServiceEmergencyCtaSection from "@/components/sections/ServiceEmergencyCtaSection.astro";
import ServiceOptionsSection from "@/components/sections/ServiceOptionsSection.astro";
import ServiceBenefitsSection from "@/components/sections/ServiceBenefitsSection.astro";
import ServiceTrustSection from "@/components/sections/ServiceTrustSection.astro";
import TestimonialQuoteSection from "@/components/sections/TestimonialQuoteSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const { servicesFolder } = config.settings;
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      const serviceIndex = await getEntryCTM(
        servicesFolder as "services",
        "-index",
        lang.languageCode,
      );

      let services = await getCollectionCTM(
        servicesFolder as "services",
        lang.languageCode,
      );

      // If draft true in index.md file frontmatter don't include any page related to this page collection in production
      if (serviceIndex?.data.draft && import.meta.env.PROD) {
        return [];
      }

      return services.map((service) => ({
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
          single: extractSlug(service).split("/").pop(),
        },
        props: {
          service,
          serviceIndex,
        },
      }));
    }),
  );

  return paths.flat();
}

const { service } = Astro.props;

const serviceId = service.id
  .split("/")
  .pop()
  ?.replace(/\.(mdx?|MDX?)$/, "");

const serviceContentPrefixes = {
  "service-01": "ac-repair",
  "service-02": "heating-repair",
  "service-03": "hvac-installation",
  "service-04": "preventive-maintenance",
  "service-05": "indoor-air-quality",
  "service-06": "emergency-hvac",
} as const;

const serviceContentPrefix =
  serviceContentPrefixes[serviceId as keyof typeof serviceContentPrefixes];
const isConfiguredHvacService = Boolean(serviceContentPrefix);
const isHeatingRepairService = serviceId === "service-02";
const isEmergencyHvacService = serviceId === "service-06";

const serviceDetailFaqContent = await getEntryCTM(
  "sections",
  "service-detail-faq-section",
  Astro.currentLocale,
);

const activeOptionsContent = serviceContentPrefix
  ? await getEntryCTM(
      "sections",
      `${serviceContentPrefix}-options-section`,
      Astro.currentLocale,
    )
  : undefined;

const activeBenefitsContent = serviceContentPrefix
  ? await getEntryCTM(
      "sections",
      `${serviceContentPrefix}-benefits-section`,
      Astro.currentLocale,
    )
  : undefined;

const activeProcessContent = serviceContentPrefix
  ? await getEntryCTM(
      "sections",
      `${serviceContentPrefix}-process-section`,
      Astro.currentLocale,
    )
  : undefined;

const activeTrustContent = serviceContentPrefix
  ? await getEntryCTM(
      "sections",
      `${serviceContentPrefix}-trust-section`,
      Astro.currentLocale,
    )
  : undefined;

const activeFaqContent = serviceContentPrefix
  ? await getEntryCTM(
      "sections",
      `${serviceContentPrefix}-faq-section`,
      Astro.currentLocale,
    )
  : serviceDetailFaqContent;

const activeFinalCtaContent = serviceContentPrefix
  ? await getEntryCTM(
      "sections",
      `${serviceContentPrefix}-final-cta`,
      Astro.currentLocale,
    )
  : undefined;

const sidebarCtaContentByService = {
  "service-01": {
    icon: "Snowflake",
    title: "Need Help With Your AC?",
    description:
      "Talk with BlueFlame Heating & Air about cooling problems, AC performance issues, and the repair needed to restore dependable comfort.",
    button: {
      enable: true,
      label: "Request AC Repair",
      url: "/#contact",
      hoverEffect: "magnetic-text-flip",
      variant: "fill",
    },
  },
  "service-02": {
    icon: "Flame",
    title: "Need Help With Your Heat?",
    description:
      "Talk with BlueFlame Heating & Air about heating problems, system performance, and the repair needed to restore dependable warmth.",
    button: {
      enable: true,
      label: "Request Heating Repair",
      url: "/#contact",
      hoverEffect: "magnetic-text-flip",
      variant: "fill",
    },
  },
  "service-03": {
    icon: "Headset",
    title: "Planning a New HVAC System?",
    description:
      "Talk with BlueFlame Heating & Air about installation options designed around your home, comfort needs, and budget.",
    button: {
      enable: true,
      label: "Request an Estimate",
      url: "/#contact",
      hoverEffect: "magnetic-text-flip",
      variant: "fill",
    },
  },
  "service-04": {
    icon: "Settings",
    title: "Is Your HVAC System Ready?",
    description:
      "Schedule preventive maintenance with BlueFlame Heating & Air to inspect your equipment and prepare it for seasonal heating and cooling demand.",
    button: {
      enable: true,
      label: "Schedule Maintenance",
      url: "/#contact",
      hoverEffect: "magnetic-text-flip",
      variant: "fill",
    },
  },
  "service-05": {
    icon: "Wind",
    title: "Want Better Indoor Air?",
    description:
      "Talk with BlueFlame Heating & Air about filtration, humidity control, and HVAC-based indoor air quality options for your home.",
    button: {
      enable: true,
      label: "Explore Air Quality Options",
      url: "/#contact",
      hoverEffect: "magnetic-text-flip",
      variant: "fill",
    },
  },
  "service-06": {
    icon: "Phone",
    title: "Need HVAC Help Now?",
    description:
      "Tell BlueFlame Heating & Air what is happening with your heating or cooling system so the problem can be evaluated and the appropriate next step determined.",
    button: {
      enable: true,
      label: "Request HVAC Service",
      url: "/#contact",
      hoverEffect: "magnetic-text-flip",
      variant: "fill",
    },
  },
} as const;

const activeSidebarCtaContent =
  sidebarCtaContentByService[
    serviceId as keyof typeof sidebarCtaContentByService
  ];
---

<Base
  {...service.data}
  fitToScreen={false}
  hideCallToAction={isConfiguredHvacService}>
  <PageHeader content={service?.data} />
  <ServicesSingle
    content={service}
    sidebarCtaContent={activeSidebarCtaContent}
  />
  {
    (isHeatingRepairService || isEmergencyHvacService) && (
      <ServiceEmergencyCtaSection />
    )
  }
  {
    isConfiguredHvacService && (
      <ServiceOptionsSection content={activeOptionsContent?.data} />
    )
  }
  {
    isConfiguredHvacService && (
      <ServiceBenefitsSection content={activeBenefitsContent?.data} />
    )
  }
  {
    isConfiguredHvacService && (
      <WorkingProcessSection
        content={activeProcessContent?.data}
        hasLightBackground
      />
    )
  }
  {
    isConfiguredHvacService && (
      <ServiceTrustSection content={activeTrustContent?.data} />
    )
  }
  {
    isConfiguredHvacService && (
      <TestimonialQuoteSection hasSectionSpacing={false} />
    )
  }
  <FaqSection content={activeFaqContent?.data} hasLightBackground />
  <ServiceAreaSection hasSectionSpacing={false} />
  {
    isConfiguredHvacService && (
      <CallToAction
        content={activeFinalCtaContent?.data}
        hasSectionSpacing={false}
      />
    )
  }
</Base>
