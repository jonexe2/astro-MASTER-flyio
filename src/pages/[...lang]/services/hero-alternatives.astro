---
import Base from "@/layouts/Base.astro";
import BannerThree from "@/components/sections/BannerThree.astro";
import WhyChooseUsSection from "@/components/sections/WhyChooseUsSection.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";

export function getStaticPaths() {
  return generatePaths();
}
---

<Base
  metaTitle="Hero Alternatives"
  fitToScreen={false}
  hideCallToAction
  headerLayout="three"
  headerPosition="fixed">
  <BannerThree />
  <WhyChooseUsSection />
</Base>
