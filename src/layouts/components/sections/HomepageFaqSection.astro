---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import type { faqSectionSchema } from "@/sections.schema";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import Icons from "@/helpers/Icons.astro";

type HomepageFaqContent = Section &
  NonNullable<z.infer<typeof faqSectionSchema>>;

const content = (
  await getEntryCTM("sections", "faq-section", Astro.currentLocale)
)?.data as HomepageFaqContent;

const { enable = true, title, items = [] } = content;

if (!enable || !title || !items.length) {
  return null;
}
---

<section
  class="section-spacing-vertical bg-white"
  aria-labelledby="homepage-faq-heading">
  <div class="container">
    <header class="mx-auto mb-12 max-w-4xl text-center lg:mb-14">
      <div
        class="flex items-center justify-center gap-3"
        data-scroll-reveal="fade-up">
        <span
          class="bg-heat-accent h-1 w-8 rounded-full"
          aria-hidden="true"
        />
        <p class="text-primary text-base-sm font-semibold tracking-widest uppercase md:text-base">
          COMMON QUESTIONS
        </p>
      </div>

      <h2
        id="homepage-faq-heading"
        class="mt-4"
        data-scroll-reveal="blur-up"
        set:html={markdownify(title)}
      />

      <p
        class="text-text-default leading-body mx-auto mt-5 max-w-3xl text-base md:text-lg"
        data-scroll-reveal="fade-up"
        data-scroll-reveal-delay="100">
        We know you have questions. Here are some of the most common ones we hear
        from homeowners in the Greater Boston area.
      </p>
    </header>

    <div
      class="homepage-faq-accordion mx-auto max-w-5xl"
      data-scroll-reveal="fade-up"
      data-scroll-reveal-delay="120">
      <div class="hs-accordion-group space-y-3">
        {
          items.map((item, index) => (
            <div
              class:list={[
                "hs-accordion hs-accordion-active:border-primary border-primary/20 rounded-xl border-2 bg-white transition-colors duration-200",
                index === 0 && "active",
              ]}
              data-group="homepage-faq"
              id={`homepage-faq-item-${index}`}>
              <button
                id={`homepage-faq-toggle-${index}`}
                type="button"
                class="hs-accordion-toggle text-dark flex w-full items-start justify-between gap-5 px-5 py-5 text-start font-semibold sm:px-7 sm:py-6 lg:px-8"
                aria-expanded={index === 0 ? "true" : "false"}
                aria-controls={`homepage-faq-content-${index}`}>
                <span class="text-h6" set:html={markdownify(item.question)} />
                <Icons
                  icon="ChevronDown"
                  class="hs-accordion-active:hidden mt-1 size-5 shrink-0"
                />
                <Icons
                  icon="ChevronUp"
                  class="text-primary hs-accordion-active:block mt-1 hidden size-5 shrink-0"
                />
              </button>

              <div
                id={`homepage-faq-content-${index}`}
                role="region"
                aria-labelledby={`homepage-faq-toggle-${index}`}
                class:list={[
                  "hs-accordion-content w-full overflow-hidden transition-[height] duration-300 ease-in-out",
                  index !== 0 && "hidden",
                ]}>
                <div class="mx-5 mb-5 sm:mx-7 sm:mb-6 lg:mx-8">
                  <p
                    class="text-text-default leading-body max-w-4xl"
                    set:html={markdownify(item.answer)}
                  />
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Keep the homepage accordion single-open and refresh reveal measurements.
  // @ts-nocheck
  import { HSAccordion } from "preline";

  window.addEventListener("load", () => {
    HSAccordion.autoInit();

    const accordions = document.querySelectorAll(
      ".homepage-faq-accordion .hs-accordion",
    );

    accordions.forEach((currentAccordion) => {
      const instance = HSAccordion.getInstance(currentAccordion, true);

      if (instance?.element) {
        instance.element.on("open", () => {
          window.__techloScrollReveal?.refresh();

          accordions.forEach((accordion) => {
            if (accordion !== currentAccordion) {
              const other = HSAccordion.getInstance(accordion, true);
              other?.element?.hide();
            }
          });
        });

        instance.element.on("close", () => {
          window.__techloScrollReveal?.refresh();
        });
      }
    });
  });
</script>
