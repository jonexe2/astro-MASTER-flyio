---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import Button from "@/components/Button.astro";
import DynamicIcon from "@/helpers/DynamicIcon.astro";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import AlternativeHeroForm from "@/components/widgets/AlternativeHeroForm.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { alternativeHeroSectionSchema } from "@/sections.schema";

type AlternativeHeroContent = Section &
  NonNullable<z.infer<typeof alternativeHeroSectionSchema>>;

type Props = {
  content?: AlternativeHeroContent;
  hasFixedHeaderOffset?: boolean;
};

const { hasFixedHeaderOffset = false } = Astro.props;

const defaultContent = (
  await getEntryCTM("sections", "alternative-hero-section", Astro.currentLocale)
)?.data as AlternativeHeroContent;

const actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content || {},
) as AlternativeHeroContent;

const {
  enable = true,
  eyebrow,
  heading,
  headingAccent,
  description,
  backgroundImage,
  backgroundImageAlt = "",
  checklist = [],
  trustBanner,
  button,
  form,
} = actualContent;

if (!enable || !heading || !form) {
  return null;
}
---

<section
  aria-labelledby="alternative-hero-heading"
  class:list={[
    "relative isolate overflow-visible",
    hasFixedHeaderOffset
      ? "pb-16 pt-48 lg:pb-20 lg:pt-40 xl:pb-24 xl:pt-44"
      : "section-spacing-vertical",
  ]}>
  {
    backgroundImage && (
      <OptimizedImage
        src={backgroundImage}
        alt={backgroundImageAlt}
        aria-hidden="true"
        width={1920}
        height={1280}
        widths={[768, 1024, 1440, 1920, 2560]}
        sizes="100vw"
        quality={78}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-20 size-full object-cover"
      />
    )
  }
  <div class="absolute inset-0 -z-10 bg-black/65" aria-hidden="true"></div>

  <div class="container max-sm:px-6">
    <div class="grid gap-12 xl:grid-cols-12 xl:items-center xl:gap-16">
      <div class="max-w-3xl xl:col-span-7">
        {
          trustBanner && (
            <div
              class="mb-8 inline-flex max-w-full flex-col gap-4 rounded-xl border border-white/15 bg-black/60 px-4 py-3 shadow-lg shadow-black/10 backdrop-blur-sm sm:flex-row sm:items-center sm:gap-5"
              aria-label="Customer trust highlights">
              <div class="flex items-center gap-3" aria-label="Google reviews">
                <svg
                  class="size-7 shrink-0"
                  viewBox="0 0 48 48"
                  role="img"
                  aria-label="Google">
                  <path
                    fill="#FFC107"
                    d="M43.6 20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11.5 0 20-8.1 20-19.5 0-1.3-.1-2.7-.4-4.5Z"
                  />
                  <path
                    fill="#FF3D00"
                    d="m6.3 14.7 6.6 4.8C14.7 15.1 18.9 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4c-7.7 0-14.3 4.4-17.7 10.7Z"
                  />
                  <path
                    fill="#4CAF50"
                    d="M24 44c5.2 0 9.8-2 13.3-5.2l-6.2-5.2C29.1 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.1 39.1 16 44 24 44Z"
                  />
                  <path
                    fill="#1976D2"
                    d="M43.6 20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.7l6.2 5.2C36.9 39.3 44 34 44 24c0-1.3-.1-2.7-.4-4Z"
                  />
                </svg>

                <div>
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span
                      class="flex items-center gap-0.5"
                      aria-label="Five stars">
                      {Array.from({ length: 5 }).map(() => (
                        <DynamicIcon
                          name="Star"
                          class="size-3.5 text-yellow-400"
                          fill="currentColor"
                          aria-hidden="true"
                        />
                      ))}
                    </span>
                    <span class="text-sm font-semibold text-white">
                      {trustBanner.googleReview.rating}
                    </span>
                  </div>
                  <p class="mt-0.5 text-xs text-white/65">
                    {trustBanner.googleReview.reviews}
                  </p>
                </div>
              </div>

              <div class="flex items-center gap-2.5 border-t border-white/15 pt-3 sm:border-t-0 sm:border-l sm:pt-0 sm:pl-5">
                <DynamicIcon
                  name="ShieldCheck"
                  class="text-primary size-5 shrink-0"
                  aria-hidden="true"
                />
                <span class="text-sm font-semibold text-white/90">
                  {trustBanner.licensedLabel}
                </span>
              </div>
            </div>
          )
        }
        {
          eyebrow && (
            <p class="mb-4 flex items-center gap-3 text-sm font-semibold text-white/90 sm:text-base">
              <span
                class="bg-primary h-5 w-1 shrink-0 rounded-full"
                aria-hidden="true"
              />
              {eyebrow}
            </p>
          )
        }

        <h1
          id="alternative-hero-heading"
          class="font-montserrat text-h2-sm sm:text-h1-sm md:text-display-6 lg:text-display-5 xl:text-display-4 leading-[1.02] font-extrabold text-white">
          {
            headingAccent && heading.endsWith(headingAccent) ? (
              <>
                {heading.slice(0, -headingAccent.length)}
                <span class="text-primary relative inline-block whitespace-nowrap">
                  {headingAccent}
                  <img
                    src="/images/hero-location-underline.png"
                    alt=""
                    width="2172"
                    height="724"
                    class="pointer-events-none absolute left-0 top-full w-full -translate-y-1/3 select-none"
                    aria-hidden="true"
                  />
                </span>
              </>
            ) : (
              heading
            )
          }
        </h1>

        <p class="mt-10 max-w-2xl text-base text-white/85 md:mt-12 md:text-lg">
          {description}
        </p>

        {
          checklist.length > 0 && (
            <ul class="mt-8 space-y-4" role="list">
              {checklist.map((item) => (
                <li class="flex items-start gap-3 text-base font-medium text-white md:text-lg">
                  <span class="bg-primary mt-1 flex size-6 shrink-0 items-center justify-center rounded-full text-white">
                    <DynamicIcon
                      name="Check"
                      class="size-4"
                      aria-hidden="true"
                    />
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )
        }

        {
          button && (
            <div class="mt-10">
              <Button {...button} />
            </div>
          )
        }

      </div>

      <div
        class="mx-auto w-full max-w-lg xl:col-span-5 xl:mx-0 xl:justify-self-end">
        <AlternativeHeroForm form={form} />
      </div>
    </div>
  </div>
</section>
