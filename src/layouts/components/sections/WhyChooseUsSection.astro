---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import { markdownify } from "@/lib/utils/textConverter";
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { whyChooseUsSectionSchema } from "@/sections.schema";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import Button from "@/components/Button.astro";

type WhyChooseUsContent = Section &
  NonNullable<z.infer<typeof whyChooseUsSectionSchema>>;

type Props = {
  content?: WhyChooseUsContent;
  hasSectionSpacing?: boolean;
  hasExtraBottomSpacing?: boolean;
};

const defaultContent = (
  await getEntryCTM("sections", "why-choose-us-section", Astro.currentLocale)
)?.data as WhyChooseUsContent;

const actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content || {},
) as WhyChooseUsContent;

const {
  enable = true,
  eyebrow,
  title,
  paragraphs = [],
  image,
  imageAlt,
  button,
} = actualContent;

const { hasSectionSpacing = true, hasExtraBottomSpacing = false } = Astro.props;
const paragraphList = Array.isArray(paragraphs)
  ? paragraphs.filter(Boolean)
  : [];

if (!enable) {
  return null;
}
---

<section
  aria-labelledby="why-choose-us-heading"
  class:list={[
    "overflow-hidden",
    !hasSectionSpacing && "pt-0",
    hasExtraBottomSpacing && "pb-16 lg:pb-20 xl:pb-24",
  ]}>
  <div class="container">
    <div
      class="grid min-w-0 items-center gap-12 lg:grid-cols-2 lg:gap-20 xl:gap-24">
      {
        image && (
          <div class="relative isolate min-w-0" data-scroll-reveal="image-clip">
            <OptimizedImage
              src="/images/banner-dots.svg"
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute -bottom-8 -left-8 -z-10 w-36 opacity-20"
            />
            <div>
              <OptimizedImage
                src={image}
                alt={imageAlt || "Residential heating and cooling equipment"}
                width={900}
                widths={[540, 720, 900, 1080]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                class="aspect-4/3 w-full rounded-xl object-cover lg:aspect-4/5 xl:aspect-4/3"
              />
            </div>
          </div>
        )
      }

      <div
        class="min-w-0"
        data-scroll-reveal="blur-up"
        data-scroll-reveal-delay="120">
        {
          eyebrow && (
            <p
              class="text-primary text-base-sm font-semibold tracking-widest uppercase md:text-base"
              set:html={markdownify(eyebrow)}
            />
          )
        }
        {
          title && (
            <h2
              id="why-choose-us-heading"
              class="mt-3"
              set:html={markdownify(title)}
            />
          )
        }
        {
          paragraphList.length > 0 && (
            <div class="mt-6 space-y-4">
              {paragraphList.map((paragraph) => (
                <p set:html={markdownify(paragraph)} />
              ))}
            </div>
          )
        }
        {
          button && (
            <div class="mt-8 w-fit">
              <Button {...button} />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
