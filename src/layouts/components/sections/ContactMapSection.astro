---
import type { z } from "astro/zod";
import { getEntryCTM } from "@/lib/contentParser.astro";
import type { serviceAreaSectionSchema } from "@/sections.schema";

type ServiceAreaContent = NonNullable<
  z.infer<typeof serviceAreaSectionSchema>
>;

const content = (
  await getEntryCTM("sections", "service-area-section", Astro.currentLocale)
)?.data as ServiceAreaContent;

const { mapEmbedUrl } = content;

if (!mapEmbedUrl) {
  return null;
}
---

<section class="pt-0">
  <div class="py-10 lg:py-12 xl:py-14">
    <div class="container">
      <div class="mx-auto max-w-5xl">
        <div class="border-border-light overflow-hidden rounded-2xl border shadow-sm">
          <iframe
            title="Google Map showing Boston, Massachusetts"
            src={mapEmbedUrl}
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            class="h-75 w-full md:h-105"
          />
        </div>
      </div>
    </div>
  </div>
</section>
