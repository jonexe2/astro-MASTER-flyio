---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import Icons from "@/helpers/Icons.astro";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { serviceTrustSectionSchema } from "@/sections.schema";

type ServiceTrustContent = Section &
  NonNullable<z.infer<typeof serviceTrustSectionSchema>>;

type Props = {
  content?: ServiceTrustContent;
};

const defaultContent = (
  await getEntryCTM(
    "sections",
    "hvac-installation-trust-section",
    Astro.currentLocale,
  )
)?.data as ServiceTrustContent;

const actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content || {},
) as ServiceTrustContent;

const {
  enable = true,
  eyebrow,
  title,
  description,
  image,
  imageAlt,
  items = [],
} = actualContent;

if (!enable || !items.length) {
  return null;
}
---

<section
  aria-labelledby="service-trust-heading"
  class="section-spacing-vertical bg-body overflow-hidden">
  <div class="container">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16 xl:gap-20">
      <div class="lg:col-span-6" data-scroll-reveal="blur-up">
        {
          eyebrow && (
            <div class="flex items-center gap-3">
              <span
                class="bg-heat-accent h-1 w-8 rounded-full"
                aria-hidden="true"
              />
              <p
                class="text-primary text-base-sm font-semibold tracking-widest uppercase md:text-base"
                set:html={markdownify(eyebrow)}
              />
            </div>
          )
        }
        {
          title && (
            <h2
              id="service-trust-heading"
              class="mt-3 max-w-2xl"
              set:html={markdownify(title)}
            />
          )
        }
        {
          description && (
            <p
              class="text-text-default leading-body mt-5 max-w-2xl"
              set:html={markdownify(description)}
            />
          )
        }

        <div class="mt-8">
          {
            items.map((item, index) => (
              <article
                class:list={[
                  "flex gap-5 py-5 md:gap-6 md:py-6",
                  index === 0 && "pt-0",
                  index < items.length - 1 && "border-border-light border-b",
                ]}>
                <span class="bg-heat-accent flex size-12 shrink-0 items-center justify-center rounded-full text-white md:size-13">
                  {item.icon && (
                    <Icons
                      icon={item.icon}
                      class="size-6"
                      stroke-width="1.8"
                      aria-hidden="true"
                    />
                  )}
                </span>
                <div>
                  <h3
                    class="text-h5-sm md:text-h5"
                    set:html={markdownify(item.title)}
                  />
                  <p
                    class="text-text-default leading-body mt-2 max-w-xl"
                    set:html={markdownify(item.description)}
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      {
        image && (
          <div
            class="lg:col-span-6"
            data-scroll-reveal="image-clip"
            data-scroll-reveal-delay="120">
            <div class="overflow-hidden rounded-2xl">
              <OptimizedImage
                src={image}
                alt={imageAlt || "BlueFlame Heating & Air HVAC team"}
                width={900}
                height={1125}
                widths={[540, 720, 900, 1080]}
                sizes="(min-width: 1024px) 42vw, 100vw"
                quality={82}
                class="aspect-4/3 w-full object-cover lg:aspect-4/5"
              />
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
